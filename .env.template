# Environment Configuration Template
# Copy this file to .env and fill in your values

# OpenAI API Key (required for LLM orchestrator)
OPENAI_API_KEY=sk-your-api-key-here

# Database Configuration
DATABASE_URL=postgresql://hg_user:hg_password@localhost:5432/hardwaregenius

# S3 Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_DOCUMENTS=hardwaregenius-documents
S3_BUCKET_EVIDENCE=hardwaregenius-evidence

# Redis
REDIS_URL=redis://localhost:6379/0

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# Ingestion Pipeline
RATE_LIMIT_DELAY=1.0  # Seconds between requests
CONFIDENCE_THRESHOLD=0.85  # Minimum confidence for auto-publishing

# Tesseract OCR (optional, uses system default if not set)
# TESSERACT_CMD=/usr/bin/tesseract
